{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ruleatlas/validation.schema.json",
  "title": "ValidationResult",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "valid",
    "issues",
    "scope"
  ],
  "properties": {
    "valid": {
      "type": "boolean"
    },
    "scope": {
      "enum": [
        "structural",
        "local_rule_consistency",
        "history_consistency"
      ]
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "path",
          "message",
          "severity"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "error",
              "warning",
              "info"
            ]
          }
        }
      }
    }
  }
}
